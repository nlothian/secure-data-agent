# Dev/e2e only. When set to 1, `npm run dev` serves the repo-root models/
# folder at /models/ and the local Gemma worker loads from there instead of
# downloading from Hugging Face. Ignored by production builds (the app checks
# import.meta.env.DEV as well). Populate the folder first:
#   npm run models:fetch -- e2b
# Either export it in your shell:
#   PUBLIC_LOCAL_MODELS=1 npm run dev
# or copy this file to site/.env and uncomment:
# PUBLIC_LOCAL_MODELS=1
