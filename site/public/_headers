# Cross-origin isolation on every page, as astro.config.mjs `server.headers`
# does in dev and preview: the ZEOS kernel worker needs SharedArrayBuffer and
# Atomics.wait. `credentialless` (not `require-corp`) keeps Google Fonts, the
# Hugging Face Hub's CDN redirects, jsDelivr and remote CSV URLs loading
# without CORP headers. Cloudflare Pages applies every matching rule, so a
# /tour-data/* URL gets these as well as its own.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless

/tour-data/*
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS
  Cache-Control: public, max-age=86400
